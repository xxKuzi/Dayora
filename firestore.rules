rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields the browser is allowed to manage on its own user document.
    // Everything else there (stripeId) is written server-side by the Stripe
    // webhook through the Admin SDK, which bypasses these rules entirely.
    function clientOwnedFields() {
      return ['settings', 'darkMode', 'comfortableTyping', 'cookiePreference'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(clientOwnedFields());

      // affectedKeys() covers the merge writes in App.tsx: a write may touch any
      // subset of the client fields, but must leave stripeId alone.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(clientOwnedFields());

      allow delete: if false;

      // Notes, folders and daily plans: the user's own content, full CRUD.
      // Rules do not cascade into subcollections, so each one is spelled out.
      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(uid);
      }

      match /dailyPlans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Subscriptions decide who is Pro, so the browser may only read them.
      // Written by the Stripe webhook (src/app/api/webhooks/stripe/route.ts).
      match /subscriptions/{subId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Daily AI/email quota counters. Read for the UI, incremented server-side
      // by the generate-plan and send-email routes — a client that could write
      // these could reset its own limit.
      match /dailyUsage/{dateStr} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
